# Copy to ignored .env.local. Never commit real credentials.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY must be a publishable/anon key, never a secret.
# Project root URL (https://<project-ref>.supabase.co), without /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact canonical origin; use localhost in local development.
APP_ORIGIN=http://localhost:3000

# Optional private team calendar connection. SERVER ONLY; never prefix these NEXT_PUBLIC_.
# A dedicated Supabase secret/service_role key is privileged across the project.
SUPABASE_SECRET_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Generate once and retain securely: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=
