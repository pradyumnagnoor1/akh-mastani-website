# Copy to ignored .env.local. Never commit real credentials.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY must be a publishable/anon key, never a secret.
# Project root URL (https://<project-ref>.supabase.co), without /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact canonical origin; use localhost in local development.
APP_ORIGIN=http://localhost:3000

# Optional private team calendar connection. SERVER ONLY; never prefix these NEXT_PUBLIC_.
# A dedicated Supabase secret/service_role key is privileged across the project.
SUPABASE_SECRET_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Generate once and retain securely: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Home Screen notifications. Run npm run push:setup to generate keys in .env.local.
# Only the public VAPID key may be exposed to browsers. Keep the pair stable.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:pradyumnagnoor@tamu.edu
# Required by the authenticated five-minute notification scheduler endpoint.
CRON_SECRET=

# Choreo: Google Drive folder URL or ID. Server-only credentials.
GOOGLE_DRIVE_CHOREO_FOLDER=15bcUJZX8TSnMAd3xqt2I_4RhlAQwQstZ
# Recommended for the TAMU-only folder: read-only OAuth grant by a TAMU account with folder access.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional alternative only when folder sharing policy permits service-account Viewer access.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Alternative for an already-public folder; restrict the key to Google Drive API.
GOOGLE_DRIVE_API_KEY=
